    },
    {
      "name": "M1Core_LoadProfile",
      "args": [
        "name"
      ],
      "returns": "Bool"
    },
    {
      "name": "M1Core_DeleteProfile",
      "args": [
        "name"
      ],
      "returns": "Bool"
    }
  ]
}
