    },
    {
      "name": "resetMod",
      "args": [
        "modId:string"
      ],
      "returns": "boolean"
    },
    {
      "name": "saveProfile",
      "args": [
        "name:string"
      ],
      "returns": "boolean"
    },
    {
      "name": "loadProfile",
      "args": [
        "name:string"
      ],
      "returns": "boolean"
    },
    {
      "name": "deleteProfile",
      "args": [
        "name:string"
      ],
      "returns": "boolean"
    },
    {
      "name": "profiles",
      "args": [],
      "returns": "string[]"
    },
    {
      "name": "lastError",
      "args": [],
      "returns": "string"
    }
  ],
  "nativeRTTI": [
    {
      "name": "M1Core_Version",
      "args": [],
      "returns": "String"
    },
    {
      "name": "M1Core_RegisterJson",
      "args": [
        "modId",
        "displayName",
        "schemaJson"
      ],
      "returns": "Bool"
    },
    {
      "name": "M1Core_GetJson",
      "args": [
        "modId",
        "settingId"
      ],
      "returns": "String"
    },
    {
      "name": "M1Core_SetJson",
      "args": [
        "modId",
        "settingId",
        "payload"
      ],
      "returns": "Bool"
    },
    {
      "name": "M1Core_ResetSetting",
      "args": [
        "modId",
        "settingId"
      ],
