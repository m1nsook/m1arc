{
  "schemaVersion": 1,
  "releaseStatus": "developer-preview",
  "runtime": "m1core standalone RED4ext DLL / LuaJIT",
  "sourceRepository": "https://github.com/m1nsook/CP2077",
  "sourceBranch": "dev/m1core-cet-foundation",
  "entrypoints": [
    "init.m1s",
    "init.lua",
    "init.m1c"
  ],
  "events": [
    {
      "name": "onHook",
      "params": []
    },
    {
      "name": "onTweak",
      "params": []
    },
    {
      "name": "onInit",
      "params": []
    },
    {
      "name": "onUpdate",
      "params": [
        "deltaTime:number"
      ]
    },
    {
      "name": "onDraw",
      "params": []
    },
    {
      "name": "onOverlayOpen",
      "params": []
    },
    {
      "name": "onOverlayClose",
      "params": []
    },
    {
      "name": "onShutdown",
      "params": []
    }
  ],
  "globals": [
    {
      "name": "registerForEvent",
      "args": [
        "eventName:string",
        "callback:function"
      ],
      "returns": "void",
      "phase": "entrypoint"
    },
    {
      "name": "registerHotkey",
      "args": [
        "id:string",
        "name:string",
        "description:string?",
        "callback:function"
      ],
      "returns": "void",
      "phase": "entrypoint"
    },
    {
      "name": "registerInput",
      "args": [
        "id:string",
        "name:string",
        "description:string?",
        "callback:function(isDown:boolean)"
      ],
      "returns": "void",
      "phase": "entrypoint"
    },
    {
      "name": "IsBound",
      "args": [
        "id:string"
      ],
      "returns": "boolean"
    },
    {
      "name": "GetBind",
      "args": [
        "id:string"
      ],
      "returns": "string"
    },
    {
      "name": "GetVersion",
      "args": [],
      "returns": "string"
    },
    {
      "name": "GetDisplayResolution",
      "args": [],
      "returns": "number,number"
    },
    {
      "name": "ModArchiveExists",
      "args": [
        "archiveName:string"
      ],
      "returns": "boolean"
    }
  ],
  "luaRegistry": [
    {
      "name": "registerJson",
      "args": [
        "modId:string",
        "title:string",
        "schemaJson:string"
      ],
      "returns": "boolean"
    },
    {
