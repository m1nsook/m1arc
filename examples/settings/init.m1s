-- m1script settings example. No CET runtime is needed.
local MOD_ID = "example.m1script_settings"
local SCHEMA = [[
[
  {"id":"enabled","kind":"boolean","default":true},
  {"id":"interval","kind":"float","default":0.5,"min":0.1,"max":5,"step":0.1}
]
]]
local elapsed = 0

registerForEvent("onInit", function()
    if not m1core.registerJson(MOD_ID, "m1script Example", SCHEMA) then
        print("[example] could not register settings")
    end
end)

registerForEvent("onUpdate", function(dt)
    elapsed = elapsed + (dt or 0)
    local interval = tonumber(m1core.getJson(MOD_ID, "interval")) or 0.5
    if elapsed < interval then return end
    elapsed = 0
    if m1core.getJson(MOD_ID, "enabled") == "true" then
        -- Add safe game-specific behavior here.
    end
end)

registerForEvent("onShutdown", function()
    -- Remove owned game resources here, if any.
end)
